# Copy this file to .env and fill in your values
# cp .env.example .env

# Port the server listens on
PORT=3001

# Secret token — clients must send this in the X-API-Key header to write state.
# Use any long random string, e.g.:  openssl rand -hex 32
API_KEY=change_me_to_something_secret

# Allowed origins for CORS (your GitHub Pages URL + localhost for dev)
# Comma-separated, no trailing slash
ALLOWED_ORIGINS=https://your-org.github.io,http://localhost:8080,http://localhost:3000
