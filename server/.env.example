# cp .env.example .env

# Port the server listens on
PORT=3001

# Owner-only write key. Generate with: openssl rand -hex 32
API_KEY=replace_with_a_long_random_write_key

# Session signing key. Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_long_random_session_secret

# Server-side users. Generate each password hash with:
#   node create-password-hash.js "new-password"
# Put the resulting one-line JSON into Render Environment / .env.
# Passwords are never stored in this repository or sent to the browser.
AUTH_USERS_JSON={"hm_root":{"role":"admin","passwordHash":"scrypt$16384$8$1$replace_with_salt$replace_with_hex_hash"},"comdep":{"role":"comdep","passwordHash":"scrypt$16384$8$1$replace_with_salt$replace_with_hex_hash"}}

# Allowed browser origins, comma-separated and without trailing slashes.
# Use the GitHub Pages URL plus localhost only for local development.
ALLOWED_ORIGINS=https://your-org.github.io,http://localhost:8080,http://localhost:3000

# Optional persistent storage
# DATABASE_URL=postgres://user:password@host:5432/database
